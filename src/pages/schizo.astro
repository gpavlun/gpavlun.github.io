---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Rock from '../components/rock.astro';
import { getCollection, render } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = await getCollection('schizo');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
    <Header />

    <div class="content-gate" id="content-gate">
      <button id="enter">VIEW CONTENT</button>
    </div>

    <audio id="music" loop>
      <source src="/videos/Stalaggh.mp3" type="audio/mpeg">
    </audio>


    <main>
      <div class="feed">
        {posts.map(async (post) => {
          const { Content } = await render(post);

          return (
            <article class="post">
              <h2>{post.data.title}</h2>
              <Content />
            </article>
          );
        })}
      </div>
    </main>

    <Footer />

    <button class="music-control" id="music-control">PAUSE</button>
  </body>
</html>

<script>
	const gate = document.querySelector('#content-gate') as HTMLElement;
	const enter = document.querySelector('#enter') as HTMLButtonElement;
	const music = document.querySelector('#music') as HTMLAudioElement;
	const control = document.querySelector('#music-control') as HTMLButtonElement;

	document.body.style.overflow = 'hidden';

	enter.addEventListener('click', async () => {
		await music.play();
		control.textContent = 'PAUSE';

		document.body.style.overflow = '';
		gate.remove();
	});

	control.addEventListener('click', async () => {
		if (music.paused) {
			await music.play();
			control.textContent = 'PAUSE';
		} else {
			music.pause();
			control.textContent = 'PLAY';
		}
	});
</script>

<style>
	main {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
	}

	.feed {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}

	.post {
		margin-bottom: 5em;
	}

	.post h2 {
		margin-bottom: 1em;
		text-align: center;
	}

	.content-gate {
	position: fixed;
	top: 70px;
	left: 0;
	right: 0;
	bottom: 0;
	z-index: 9999;
	display: flex;
	align-items: center;
	justify-content: center;
	background: black;
}

#enter {
	background: none;
	border: 1px solid #00ffcc;
	color: #00ffcc;
	padding: 15px 30px;
	font-family: inherit;
	font-size: 18px;
	cursor: pointer;
}

#enter:hover {
	background: #00ffcc;
	color: black;
}

.music-control {
	position: fixed;
	bottom: 15px;
	right: 15px;
	z-index: 1000;
	background: black;
	border: 1px solid #00ffcc;
	color: #00ffcc;
	padding: 8px 12px;
	font-family: inherit;
	cursor: pointer;
}

.music-control:hover {
	background: #00ffcc;
	color: black;
}

</style>