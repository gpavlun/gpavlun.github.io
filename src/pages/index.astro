---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Rock from '../components/rock.astro';
import text from '../data/bin.txt?raw';
---

<!doctype html>
<html lang="en">
<style>
	.mainlayout{
		display: flex;
		flex-direction: row;
		height: 100%;
		width: 100%;
		border: solid green 5px;
	}
	:global(.enlightened){
		color: var(--gold);
		text-shadow: 0 0 8px var(--gold);
	}
	:global(.sacrosanct){
		color: #ff0000;
		text-shadow: 0 0 8px #ff0000;
	}
	:global(.winding){
		color: #007e26;
		text-shadow: 0 0 8px #007e26;
	}
	:global(.frosted){
		color: #008ccd;
		text-shadow: 0 0 8px #008ccd;
	}
	:global(.stronghold){
		color: #ca6517;
		text-shadow: 0 0 8px #ca6517;
	}
	:global(.landvet){
		color: #003c14;
		text-shadow: 0 0 8px #003c14;
	}
</style>

	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
			<Rock />
			<main>
				<h1>ᛒᚱᛁᚾᚾᚨᚾᛞᛁ ᚨᚢᚷᛟᚾᛟ</h1>
				<h1></h1>
				
				<p set:html={text}></p>
			</main>
		<Footer />
	</body>
</html>
