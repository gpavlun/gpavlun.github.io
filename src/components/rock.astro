---
import myImage from '../assets/runestone-tra-flipped.png';
---

<div class="corner-box">
	<a href="/about">
		<img src={myImage.src} alt="Description" />
	</a>
</div>
<style>
  .corner-box {
    position: fixed;
    bottom: 5px;
    left: 5px;
    height: 200px;
  }
  .corner-box img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
	.corner-box:hover {
  box-shadow: 0 0 12px #00ffcc;
}
		</style>
